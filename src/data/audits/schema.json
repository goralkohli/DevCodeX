{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TopicAuditSchema",
  "type": "object",
  "required": [
    "topicId",
    "topicTitle",
    "generatedAt",
    "engine",
    "complexity",
    "executionTrace",
    "pitfalls",
    "seniorInterviewTip"
  ],
  "properties": {
    "topicId": {
      "type": "string"
    },
    "topicTitle": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "engine": {
      "type": "string",
      "enum": ["deepseek-chat"]
    },
    "complexity": {
      "type": "object",
      "required": ["time", "space", "explanation"],
      "properties": {
        "time": {
          "type": "string"
        },
        "space": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        }
      }
    },
    "executionTrace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "codeLine", "action", "memoryDetail"],
        "properties": {
          "step": {
            "type": "integer"
          },
          "codeLine": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "memoryDetail": {
            "type": "string"
          }
        }
      }
    },
    "pitfalls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity",
          "description",
          "badSnippet",
          "goodSnippet"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "description": {
            "type": "string"
          },
          "badSnippet": {
            "type": "string"
          },
          "goodSnippet": {
            "type": "string"
          }
        }
      }
    },
    "seniorInterviewTip": {
      "type": "string"
    }
  }
}
